# ===== CONFIGURACIÓN OPCIONAL DEL SERVIDOR =====

# Puerto en el que escuchará el servidor
# Por defecto: 3000
PORT=3000

# Secreto para firmar tokens JWT
# CAMBIAR ESTO EN PRODUCCIÓN CON UN VALOR ÚNICO Y SEGURO
# Por defecto: 'tu-secreto-muy-seguro-cambiar-en-produccion'
JWT_SECRET=tu-secreto-supernuevo-muy-seguro-cambiar-en-produccion-123456

# Tiempo de expiración de los tokens JWT
# Por defecto: 7d (7 días)
# Otros ejemplos: 24h, 30d, 1y
JWT_EXPIRY=7d

# ===== INSTRUCCIONES DE USO =====

# 1. Copia este archivo a .env:
#    cp .env.example .env

# 2. Edita el archivo .env con tus valores personalizados

# 3. El servidor leerá automáticamente las variables de .env

# ===== NOTAS IMPORTANTES =====

# En producción, asegúrate de:
# - Cambiar JWT_SECRET a un valor único y largo
# - Usar HTTPS en lugar de HTTP
# - Hacer backup regular de la base de datos (datos.db)
# - Configurar un firewall adecuado
# - Considerar usar una base de datos más robusta (PostgreSQL)
